    "/api/v1/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get All Orders",
        "responses": {
          "200": {
            "description": "Daftar order berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create Order",
        "description": "Membuat order baru. Backend menghitung subtotal, discount, tax, dan total_amount.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              },
              "example": {
                "order_type": "DINE_IN",
                "table_number": "A05",
                "items": [
                  {
                    "product_id": 1,
                    "variant_id": 2,
                    "quantity": 2,
                    "notes": "Less sugar"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order berhasil dibuat"
          },
          "400": {
            "description": "Data order tidak valid"
          }
        }
      }
    },

    "/api/v1/orders/my": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get My Orders",
        "description": "Mengambil order milik customer yang sedang login.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
