    "/api/v1/inventory": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Get All Inventory Movements",
        "responses": {
          "200": {
            "description": "Daftar inventory movement berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Create Inventory Movement",
        "description": "Membuat pergerakan stok IN, OUT, atau ADJUSTMENT. Backend memperbarui stock produk secara transaction-safe.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryRequest"
              },
              "examples": {
                "stockIn": {
                  "summary": "Stock IN",
                  "value": {
                    "product_id": 1,
                    "type": "IN",
                    "quantity": 20,
                    "note": "Stok pembelian baru"
                  }
                },
                "stockOut": {
                  "summary": "Stock OUT",
                  "value": {
                    "product_id": 1,
                    "type": "OUT",
                    "quantity": 2,
                    "note": "Stok rusak"
                  }
                },
                "adjustment": {
                  "summary": "Stock Adjustment",
                  "value": {
                    "product_id": 1,
                    "type": "ADJUSTMENT",
                    "quantity": 50,
                    "note": "Penyesuaian stok"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inventory movement berhasil dibuat"
          }
        }
      }
    },

    "/api/v1/inventory/{id}": {
      "get": {
        "tags": [
