                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },

    "/api/v1/orders/{id}/assign": {
      "patch": {
        "tags": [
          "Orders"
        ],
        "summary": "Assign Cashier To Order",
        "description": "Menentukan cashier yang menangani order.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
