    "/api/v1/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get User By ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User ditemukan"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Update User",
        "description": "Memperbarui data user. Owner ID 1 dilindungi dari perubahan tertentu oleh service.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User berhasil diperbarui"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Delete User",
        "description": "Menghapus user. Owner utama dengan ID 1 tidak dapat dihapus.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User berhasil dihapus"
          },
          "400": {
            "description": "User tidak dapat dihapus"
          }
        }
      }
    },

    "/api/v1/users/cashier": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create Cashier",
        "description": "Membuat akun cashier. Backend secara otomatis memberikan role CASHIER.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCashierRequest"
              },
              "example": {
                "name": "Budi",
                "email": "budi@cafe.com",
                "password": "Budi123",
                "phone": "081234567890"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cashier berhasil dibuat"
          }
        }
      }
    },

